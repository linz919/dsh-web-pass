{
  "name": "dsh-web-pass",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DSH web-password gate: cookie-password auth + forced first-time setup + Settings 'Web password' tab + size-capped access log. Zero dependencies.",
  "license": "MIT",
  "author": "linz919",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linz919/dsh-web-pass.git"
  },
  "bugs": {
    "url": "https://github.com/linz919/dsh-web-pass/issues"
  },
  "homepage": "https://github.com/linz919/dsh-web-pass#readme",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}