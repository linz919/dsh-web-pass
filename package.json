{
  "name": "dsh-web-pass",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DSH web-password gate: cookie-password auth + forced first-time setup + Settings 'Web password' tab + 30-day access log. Zero dependencies.",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ]
}